# Optional local/preview override. Production SEO metadata always uses the
# canonical https://moonlancer.ir origin.
NEXT_PUBLIC_SITE_URL=https://moonlancer.ir

# Privacy-focused analytics. Both values are required to load the script.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Cloudflare Turnstile. Production submissions require both values.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Required in production: the accountable CRM or lead-routing webhook. It owns
# notification, submitter summary email, workflow rate limits, retention, and next action.
MOONLANCER_LEADS_WEBHOOK_URL=

# Optional bearer token when the lead owner requires authentication.
MOONLANCER_LEADS_WEBHOOK_TOKEN=
